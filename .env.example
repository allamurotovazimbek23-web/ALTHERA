# ALTHERA server environment — copy to server/.env (or use Docker compose env_file)

# HTTP port for API + static client
PORT=8787

# REQUIRED in production: secret used to sign JWTs (openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string

# Telegram Mini App auth: token from @BotFather
TELEGRAM_BOT_TOKEN=

# AI Mentor (OpenAI-compatible). Without a key, /api/mentor/chat returns
# a structured mentor_not_configured error with setup
#instructions.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Click (Uzbekistan) Merchant API payments
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=:CLICK_SECRET_KEY=

# Public URL of the app (Click return URL)
APP_URL=

# CORS origin if the client is served from a different origin (local dev)
CLIENT_ORIGIN=

# Directory for the SQLite database file
SQLITE_DIR=
